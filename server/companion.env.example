# Пример настроек. Сервис НЕ читает файл автоматически.
# source server/companion.env.example — загрузка пустой учебной конфигурации в zsh/bash.
export WORKBENCH_PORT=8787
export WORKBENCH_DATA_DIR=.workbench-data
export WORKBENCH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Внешний AI выключен, пока владелец отдельно не задаст оба значения.
export OPENAI_API_KEY=
export WORKBENCH_AI_MODEL=
