{
  "name": "it-support-workbench",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Local-first IT support workbench for Windows diagnostics, guided troubleshooting, network tools, and hands-on learning",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "test:changed": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:ui": "playwright test e2e/visual-ui.spec.ts --project=chromium --project=webkit",
    "test:e2e:all": "playwright test",
    "check:architecture": "node scripts/check-architecture.mjs && node --test scripts/architecture/architecture.test.mjs",
    "check": "npm run check:architecture && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "check:quick": "npm run check:architecture && npm run lint && npm run typecheck",
    "check:feature": "node scripts/check-feature.mjs",
    "check:full": "npm run check:architecture && npm run format:check && npm run lint && npm run test:coverage && npm run test:companion && npm run build && npm run test:e2e:all",
    "companion": "node server/companion.mjs",
    "test:companion": "node --test server/companion.test.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:lab:linux": "node scripts/check-linux-lab.mjs",
    "test:fixtures:real": "node scripts/check-real-fixtures.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.55.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dexie": "4.4.6",
    "pinia": "4.0.3",
    "reka-ui": "2.11.0",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
